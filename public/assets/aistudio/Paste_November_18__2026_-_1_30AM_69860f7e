"use client";

import React from "react";
import Link from "next/link";
import { useStore } from "@/store/useStore";
import { formatToman, getLevelBadge, toPersianDigits } from "@/lib/utils";
import { toast } from "sonner";
import {
  Clock,
  Users,
  Star,
  ShoppingCart,
  Heart,
  UserCheck,
} from "lucide-react";

export interface CourseCardProps {
  course: {
    id: string;
    title: string;
    slug: string;
    shortDesc: string;
    thumbnail: string;
    price: number;
    discountPrice: number | null;
    level: string;
    duration: string;
    instructorName: string;
    studentsCount: number;
    rating: number;
    category?: { name: string };
  };
}

export function CourseCard({ course }: CourseCardProps) {
  const { addToCart, setCartDrawerOpen, toggleWishlist, wishlist } = useStore();
  const isWishlisted = wishlist.some((w) => w.id === course.id);
  const badge = getLevelBadge(course.level);

  const handleAddToCart = () => {
    const added = addToCart({
      id: course.id,
      title: course.title,
      slug: course.slug,
      thumbnail: course.thumbnail,
      instructorName: course.instructorName,
      price: course.price,
      discountPrice: course.discountPrice,
    });
    if (added) {
      toast.success("دوره به سبد خرید شما اضافه شد!");
      setCartDrawerOpen(true);
    } else {
      toast.info("این دوره قبلاً به سبد خرید شما اضافه شده است.");
      setCartDrawerOpen(true);
    }
  };

  const handleWishlist = () => {
    const added = toggleWishlist({
      id: course.id,
      title: course.title,
      slug: course.slug,
      thumbnail: course.thumbnail,
      instructorName: course.instructorName,
      price: course.price,
      discountPrice: course.discountPrice,
    });
    if (added) toast.success("به لیست علاقه‌مندی‌ها اضافه شد.");
    else toast.info("از لیست علاقه‌مندی‌ها حذف شد.");
  };

  const hasDiscount =
    course.discountPrice !== null && course.discountPrice < course.price;
  const discountPercent = hasDiscount
    ? Math.round(((course.price - course.discountPrice!) / course.price) * 100)
    : 0;

  return (
    <div className="group flex flex-col overflow-hidden rounded-2xl border border-slate-800/90 bg-slate-900/70 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/50 hover:shadow-2xl hover:shadow-indigo-950/40">
      {/* Thumbnail */}
      <div className="relative aspect-video w-full overflow-hidden bg-slate-950">
        <Link href={`/courses/${course.slug}`}>
          <img
            src={course.thumbnail}
            alt={course.title}
            className="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </Link>

        {/* Badges */}
        <div className="absolute right-3 top-3 flex flex-wrap gap-1.5">
          <span
            className={`rounded-lg border px-2.5 py-1 text-[11px] font-bold backdrop-blur-md ${badge.color}`}
          >
            {badge.label}
          </span>
          {hasDiscount && discountPercent > 0 && (
            <span className="rounded-lg bg-emerald-500 px-2.5 py-1 text-[11px] font-black text-slate-950 shadow">
              {toPersianDigits(discountPercent)}٪ تخفیف
            </span>
          )}
        </div>

        <button
          onClick={handleWishlist}
          title="افزودن به علاقه‌مندی‌ها"
          className={`absolute left-3 top-3 flex h-8 w-8 items-center justify-center rounded-xl backdrop-blur-md transition ${
            isWishlisted
              ? "bg-rose-500 text-white"
              : "bg-slate-950/70 text-slate-300 hover:text-rose-400"
          }`}
        >
          <Heart className="h-4 w-4 fill-current" />
        </button>
      </div>

      {/* Body */}
      <div className="flex flex-1 flex-col p-5">
        {course.category && (
          <span className="mb-1.5 text-[11px] font-semibold text-indigo-400">
            {course.category.name}
          </span>
        )}

        <Link
          href={`/courses/${course.slug}`}
          className="line-clamp-2 text-base font-bold leading-snug text-slate-100 group-hover:text-indigo-400 transition"
        >
          {course.title}
        </Link>

        <p className="mt-2 line-clamp-2 text-xs leading-relaxed text-slate-400">
          {course.shortDesc}
        </p>

        {/* Instructor & Rating */}
        <div className="mt-4 flex items-center justify-between border-b border-slate-800/80 pb-3 text-xs text-slate-400">
          <div className="flex items-center gap-1.5">
            <UserCheck className="h-3.5 w-3.5 text-indigo-400" />
            <span className="truncate max-w-[140px]">{course.instructorName}</span>
          </div>
          <div className="flex items-center gap-1 text-amber-400 font-bold">
            <span>{toPersianDigits(course.rating.toFixed(1))}</span>
            <Star className="h-3.5 w-3.5 fill-amber-400" />
          </div>
        </div>

        {/* Meta Info */}
        <div className="mt-3 flex items-center justify-between text-xs text-slate-400">
          <div className="flex items-center gap-1">
            <Clock className="h-3.5 w-3.5 text-slate-500" />
            <span>{course.duration}</span>
          </div>
          <div className="flex items-center gap-1">
            <Users className="h-3.5 w-3.5 text-slate-500" />
            <span>{toPersianDigits(course.studentsCount)} دانشجو</span>
          </div>
        </div>

        {/* Price & CTA */}
        <div className="mt-auto pt-4 flex items-center justify-between">
          <div>
            {hasDiscount && (
              <div className="text-xs text-slate-500 line-through">
                {formatToman(course.price)}
              </div>
            )}
            <div className="text-base font-black text-emerald-400">
              {formatToman(course.discountPrice ?? course.price)}
            </div>
          </div>

          <button
            onClick={handleAddToCart}
            className="flex items-center gap-1.5 rounded-xl bg-indigo-600 px-3.5 py-2.5 text-xs font-bold text-white shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition"
          >
            <ShoppingCart className="h-4 w-4" />
            <span>ثبت‌نام دوره</span>
          </button>
        </div>
      </div>
    </div>
  );
}

