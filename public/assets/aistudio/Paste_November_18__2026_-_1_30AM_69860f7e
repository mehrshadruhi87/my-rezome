"use client";

import React from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { Filter, RotateCcw } from "lucide-react";

interface Props {
  categories: { id: string; name: string; slug: string }[];
}

export function CourseFilters({ categories }: Props) {
  const router = useRouter();
  const searchParams = useSearchParams();

  const currentCategory = searchParams.get("category") || "";
  const currentLevel = searchParams.get("level") || "";
  const currentPrice = searchParams.get("price") || "";
  const currentSort = searchParams.get("sort") || "newest";
  const currentQuery = searchParams.get("q") || "";

  const updateFilter = (key: string, value: string) => {
    const params = new URLSearchParams(searchParams.toString());
    if (value) {
      params.set(key, value);
    } else {
      params.delete(key);
    }
    router.push(`/courses?${params.toString()}`);
  };

  const resetAll = () => {
    router.push("/courses");
  };

  return (
    <div className="space-y-6 rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <div className="flex items-center justify-between border-b border-slate-800 pb-3">
        <div className="flex items-center gap-2 text-sm font-bold text-white">
          <Filter className="h-4 w-4 text-indigo-400" />
          <span>فیلترهای پیشرفته</span>
        </div>
        <button
          onClick={resetAll}
          className="flex items-center gap-1 text-xs text-slate-400 hover:text-rose-400 transition"
        >
          <RotateCcw className="h-3.5 w-3.5" />
          <span>حذف فیلترها</span>
        </button>
      </div>

      {/* Search Input */}
      <div>
        <label className="block text-xs font-bold text-slate-300 mb-2">
          جستجو در عنوان دوره
        </label>
        <input
          type="text"
          defaultValue={currentQuery}
          onKeyDown={(e) => {
            if (e.key === "Enter") {
              updateFilter("q", (e.target as HTMLInputElement).value);
            }
          }}
          placeholder="نام دوره + Enter..."
          className="w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2 text-xs text-white focus:border-indigo-500 focus:outline-none"
        />
      </div>

      {/* Sort By */}
      <div>
        <label className="block text-xs font-bold text-slate-300 mb-2">
          مرتب‌سازی بر اساس
        </label>
        <select
          value={currentSort}
          onChange={(e) => updateFilter("sort", e.target.value)}
          className="w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs text-slate-200 focus:border-indigo-500 focus:outline-none"
        >
          <option value="newest">جدیدترین دوره‌ها</option>
          <option value="popular">پرفروش‌ترین و محبوب‌ترین</option>
          <option value="cheapest">ارزان‌ترین قیمت</option>
        </select>
      </div>

      {/* Category Filter */}
      <div>
        <label className="block text-xs font-bold text-slate-300 mb-2">
          دپارتمان تخصصی
        </label>
        <div className="space-y-1.5">
          <button
            onClick={() => updateFilter("category", "")}
            className={`w-full text-right rounded-xl px-3 py-2 text-xs transition ${
              currentCategory === ""
                ? "bg-indigo-600 text-white font-bold"
                : "text-slate-400 hover:bg-slate-800"
            }`}
          >
            همه دسته‌بندی‌ها
          </button>
          {categories.map((cat) => (
            <button
              key={cat.id}
              onClick={() => updateFilter("category", cat.slug)}
              className={`w-full text-right rounded-xl px-3 py-2 text-xs transition ${
                currentCategory === cat.slug
                  ? "bg-indigo-600 text-white font-bold"
                  : "text-slate-400 hover:bg-slate-800"
              }`}
            >
              {cat.name}
            </button>
          ))}
        </div>
      </div>

      {/* Skill Level Filter */}
      <div>
        <label className="block text-xs font-bold text-slate-300 mb-2">
          سطح مهارت دوره
        </label>
        <div className="grid grid-cols-2 gap-2">
          {[
            { value: "", label: "همه سطوح" },
            { value: "BEGINNER", label: "مقدماتی" },
            { value: "INTERMEDIATE", label: "متوسط" },
            { value: "ADVANCED", label: "پیشرفته" },
            { value: "ALL_LEVELS", label: "جامع (صفر تا صد)" },
          ].map((lvl) => (
            <button
              key={lvl.value}
              onClick={() => updateFilter("level", lvl.value)}
              className={`rounded-xl border px-2.5 py-2 text-xs transition ${
                currentLevel === lvl.value
                  ? "border-indigo-500 bg-indigo-500/20 text-indigo-300 font-bold"
                  : "border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700"
              }`}
            >
              {lvl.label}
            </button>
          ))}
        </div>
      </div>

      {/* Price Type */}
      <div>
        <label className="block text-xs font-bold text-slate-300 mb-2">
          نوع سرمایه‌گذاری
        </label>
        <div className="grid grid-cols-3 gap-2">
          {[
            { value: "", label: "همه" },
            { value: "free", label: "رایگان" },
            { value: "paid", label: "نقدی / ویژه" },
          ].map((pr) => (
            <button
              key={pr.value}
              onClick={() => updateFilter("price", pr.value)}
              className={`rounded-xl border px-2.5 py-2 text-xs transition ${
                currentPrice === pr.value
                  ? "border-emerald-500 bg-emerald-500/20 text-emerald-300 font-bold"
                  : "border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700"
              }`}
            >
              {pr.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}

