"use client";

import { create } from "zustand";
import { persist } from "zustand/middleware";

export interface CartCourseItem {
  id: string;
  title: string;
  slug: string;
  thumbnail: string;
  instructorName: string;
  price: number;
  discountPrice: number | null;
}

interface AppliedCoupon {
  code: string;
  type: "PERCENTAGE" | "FIXED";
  value: number;
}

interface StoreState {
  cart: CartCourseItem[];
  wishlist: CartCourseItem[];
  isCartDrawerOpen: boolean;
  coupon: AppliedCoupon | null;
  setCartDrawerOpen: (open: boolean) => void;
  addToCart: (item: CartCourseItem) => boolean;
  removeFromCart: (id: string) => void;
  clearCart: () => void;
  toggleWishlist: (item: CartCourseItem) => boolean; // true = added, false = removed
  applyCouponState: (coupon: AppliedCoupon | null) => void;
  getCartTotals: () => {
    subtotal: number;
    courseDiscount: number;
    couponDiscount: number;
    finalTotal: number;
  };
}

export const useStore = create<StoreState>()(
  persist(
    (set, get) => ({
      cart: [],
      wishlist: [],
      isCartDrawerOpen: false,
      coupon: null,

      setCartDrawerOpen: (open) => set({ isCartDrawerOpen: open }),

      addToCart: (item) => {
        const exists = get().cart.some((c) => c.id === item.id);
        if (exists) return false;
        set((state) => ({ cart: [...state.cart, item] }));
        return true;
      },

      removeFromCart: (id) =>
        set((state) => ({
          cart: state.cart.filter((item) => item.id !== id),
        })),

      clearCart: () => set({ cart: [], coupon: null }),

      toggleWishlist: (item) => {
        const exists = get().wishlist.some((c) => c.id === item.id);
        if (exists) {
          set((state) => ({
            wishlist: state.wishlist.filter((c) => c.id !== item.id),
          }));
          return false;
        } else {
          set((state) => ({ wishlist: [...state.wishlist, item] }));
          return true;
        }
      },

      applyCouponState: (coupon) => set({ coupon }),

      getCartTotals: () => {
        const { cart, coupon } = get();
        const subtotal = cart.reduce((acc, item) => acc + item.price, 0);
        const afterCourseDiscount = cart.reduce(
          (acc, item) =>
            acc + (item.discountPrice !== null ? item.discountPrice : item.price),
          0
        );
        const courseDiscount = subtotal - afterCourseDiscount;

        let couponDiscount = 0;
        if (coupon && afterCourseDiscount > 0) {
          if (coupon.type === "PERCENTAGE") {
            couponDiscount = Math.round((afterCourseDiscount * coupon.value) / 100);
          } else {
            couponDiscount = Math.min(afterCourseDiscount, coupon.value);
          }
        }

        const finalTotal = Math.max(0, afterCourseDiscount - couponDiscount);
        return {
          subtotal,
          courseDiscount,
          couponDiscount,
          finalTotal,
        };
      },
    }),
    {
      name: "codeacademy-storage",
      partialize: (state) => ({
        cart: state.cart,
        wishlist: state.wishlist,
        coupon: state.coupon,
      }),
    }
  )
);

