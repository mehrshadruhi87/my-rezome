export async function saveCourseWithCurriculum(data: UpsertCourseInput) {
  await requireAdmin();

  const cleanSlug = data.slug?.trim()
    ? generateSlug(data.slug)
    : generateSlug(data.title);

  if (data.id) {
    // Update existing course & rebuild chapters/lessons atomically
    await prisma.$transaction(async (tx) => {
      await tx.chapter.deleteMany({ where: { courseId: data.id } });

      await tx.course.update({
        where: { id: data.id },
        data: {
          title: data.title,
          slug: cleanSlug,
          shortDesc: data.shortDesc,
          description: data.description,
          thumbnail: data.thumbnail,
          previewVideoUrl: data.previewVideoUrl,
          price: Number(data.price),
          discountPrice:
            data.discountPrice !== null && data.discountPrice >= 0
              ? Number(data.discountPrice)
              : null,
          level: data.level,
          duration: data.duration,
          prerequisites: data.prerequisites,
          instructorName: data.instructorName,
          instructorTitle: data.instructorTitle,
          categoryId: data.categoryId,
          isPublished: data.isPublished,
          isFeatured: data.isFeatured,
          chapters: {
            create: data.chapters.map((ch, cIdx) => ({
              title: ch.title,
              position: cIdx + 1,
              lessons: {
                create: ch.lessons.map((les, lIdx) => ({
                  title: les.title,
                  duration: les.duration || "۱۵:۰۰",
                  videoUrl: les.videoUrl,
                  isFree: les.isFree,
                  position: lIdx + 1,
                })),
              },
            })),
          },
        },
      });
    });
  } else {
    await prisma.course.create({
      data: {
        title: data.title,
        slug: `${cleanSlug}-${Math.floor(100 + Math.random() * 900)}`,
        shortDesc: data.shortDesc,
        description: data.description,
        thumbnail: data.thumbnail,
        previewVideoUrl: data.previewVideoUrl,
        price: Number(data.price),
        discountPrice:
          data.discountPrice !== null && data.discountPrice >= 0
            ? Number(data.discountPrice)
            : null,
        level: data.level,
        duration: data.duration,
        prerequisites: data.prerequisites,
        instructorName: data.instructorName,
        instructorTitle: data.instructorTitle,
        categoryId: data.categoryId,
        isPublished: data.isPublished,
        isFeatured: data.isFeatured,
        chapters: {
          create: data.chapters.map((ch, cIdx) => ({
            title: ch.title,
            position: cIdx + 1,
            lessons: {
              create: ch.lessons.map((les, lIdx) => ({
                title: les.title,
                duration: les.duration || "۱۵:۰۰",
                videoUrl: les.videoUrl,
                isFree: les.isFree,
                position: lIdx + 1,
              })),
            },
          })),
        },
      },
    });
  }

  revalidatePath("/");
  revalidatePath("/courses");
  revalidatePath("/admin/courses");
  return { success: true };
}

