"use server";

import { prisma } from "@/lib/prisma";
import { getServerSession } from "next-auth";
import { authOptions } from "@/lib/auth";
import { revalidatePath } from "next/cache";

export async function validateCouponAction(code: string) {
  const cleanCode = code.trim().toUpperCase();
  if (!cleanCode) throw new Error("لطفاً کد تخفیف را وارد کنید.");

  const discount = await prisma.discountCode.findUnique({
    where: { code: cleanCode },
  });

  if (!discount || !discount.isActive) {
    throw new Error("کد تخفیف وارد شده معتبر نیست یا غیرفعال شده است.");
  }

  if (discount.usedCount >= discount.maxUses) {
    throw new Error("ظرفیت استفاده از این کد تخفیف به پایان رسیده است.");
  }

  if (discount.expiresAt && new Date(discount.expiresAt) < new Date()) {
    throw new Error("مهلت استفاده از این کد تخفیف منقضی شده است.");
  }

  return {
    code: discount.code,
    type: discount.type as "PERCENTAGE" | "FIXED",
    value: discount.value,
  };
}

export async function initiateCheckoutAction(
  courseIds: string[],
  couponCode?: string | null
) {
  const session = await getServerSession(authOptions);
  if (!session?.user) {
    throw new Error("برای تکمیل خرید ابتدا وارد حساب کاربری خود شوید.");
  }

  if (!courseIds.length) {
    throw new Error("سبد خرید شما خالی است.");
  }

  const courses = await prisma.course.findMany({
    where: { id: { in: courseIds } },
  });

  if (!courses.length) {
    throw new Error("دوره‌های انتخاب شده یافت نشدند.");
  }

  const subtotal = courses.reduce((sum, c) => sum + c.price, 0);
  const afterCourseDiscounts = courses.reduce(
    (sum, c) => sum + (c.discountPrice !== null ? c.discountPrice : c.price),
    0
  );

  let couponDiscount = 0;
  let validCouponCode: string | null = null;

  if (couponCode) {
    const discount = await prisma.discountCode.findUnique({
      where: { code: couponCode.toUpperCase() },
    });
    if (
      discount &&
      discount.isActive &&
      discount.usedCount < discount.maxUses &&
      (!discount.expiresAt || new Date(discount.expiresAt) > new Date())
    ) {
      validCouponCode = discount.code;
      if (discount.type === "PERCENTAGE") {
        couponDiscount = Math.round((afterCourseDiscounts * discount.value) / 100);
      } else {
        couponDiscount = Math.min(afterCourseDiscounts, discount.value);
      }
    }
  }

  const finalAmount = Math.max(0, afterCourseDiscounts - couponDiscount);
  const totalDiscount = subtotal - finalAmount;
  const orderNumber = `ORD-${Math.floor(100000 + Math.random() * 900000)}`;

  const order = await prisma.order.create({
    data: {
      orderNumber,
      userId: session.user.id,
      totalAmount: subtotal,
      discountAmount: totalDiscount,
      finalAmount,
      couponCode: validCouponCode,
      status: "PENDING",
      items: {
        create: courses.map((c) => ({
          courseId: c.id,
          price: c.discountPrice !== null ? c.discountPrice : c.price,
        })),
      },
    },
  });

  return { orderId: order.id, finalAmount };
}

export async function verifySimulatedPaymentAction(
  orderId: string,
  status: "SUCCESS" | "FAILED"
) {
  const session = await getServerSession(authOptions);
  if (!session?.user) throw new Error("احراز هویت نامعتبر.");

  const order = await prisma.order.findUnique({
    where: { id: orderId },
    include: { items: true },
  });

  if (!order) throw new Error("سفارش یافت نشد.");
  if (order.status === "COMPLETED") return { success: true };

  if (status === "FAILED") {
    await prisma.order.update({
      where: { id: orderId },
      data: { status: "FAILED" },
    });
    return { success: false };
  }

  const paymentRef = `ZP-${Math.floor(10000000 + Math.random() * 90000000)}`;

  await prisma.$transaction(async (tx) => {
    await tx.order.update({
      where: { id: orderId },
      data: {
        status: "COMPLETED",
        paymentRef,
      },
    });

    if (order.couponCode) {
      await tx.discountCode.updateMany({
        where: { code: order.couponCode },
        data: { usedCount: { increment: 1 } },
      });
    }

    for (const item of order.items) {
      const exists = await tx.enrollment.findUnique({
        where: {
          userId_courseId: {
            userId: order.userId,
            courseId: item.courseId,
          },
        },
      });

      if (!exists) {
        await tx.enrollment.create({
          data: {
            userId: order.userId,
            courseId: item.courseId,
          },
        });
        await tx.course.update({
          where: { id: item.courseId },
          data: { studentsCount: { increment: 1 } },
        });
      }
    }
  });

  revalidatePath("/dashboard");
  revalidatePath("/admin");
  revalidatePath("/admin/orders");
  return { success: true, paymentRef };
}

