2. Database Schema & Seed Data (prisma/)

prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" for production PostgreSQL deployment
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("STUDENT") // "ADMIN" | "STUDENT"
  avatar       String?
  bio          String?
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  enrollments  Enrollment[]
  reviews      Review[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String   @default("Code2")
  description String?
  courses     Course[]
  createdAt   DateTime @default(now())
}

model Course {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  shortDesc       String
  description     String
  thumbnail       String
  previewVideoUrl String
  price           Int          // Price in Tomans (0 = Free)
  discountPrice   Int?         // Discounted price in Tomans
  level           String       @default("ALL_LEVELS") // BEGINNER | INTERMEDIATE | ADVANCED | ALL_LEVELS
  duration        String       // e.g., "۴۸ ساعت"
  prerequisites   String       @default("آشنایی مقدماتی با کامپیوتر")
  language        String       @default("فارسی")
  instructorName  String
  instructorTitle String       @default("مهندس ارشد نرم‌افزار")
  instructorBio   String       @default("مدرس و معمار سیستم‌های نرم‌افزاری با بیش از ۱۰ سال سابقه در پروژه‌های مقیاس‌پذیر.")
  isPublished     Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  studentsCount   Int          @default(0)
  rating          Float        @default(4.9)
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  orderItems      OrderItem[]
  enrollments     Enrollment[]
  reviews         Review[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  position  Int      @default(1)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  duration    String   @default("۱۵:۰۰")
  videoUrl    String
  isFree      Boolean  @default(false)
  position    Int      @default(1)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount    Int         // Original sum in Tomans
  discountAmount Int         @default(0)
  finalAmount    Int         // Final paid in Tomans
  status         String      @default("PENDING") // PENDING | COMPLETED | FAILED
  paymentRef     String?     // ZarinPal / Shaparak tracking code
  couponCode     String?
  items          OrderItem[]
  createdAt      DateTime    @default(now())
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  price    Int
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DiscountCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  value     Int       // e.g., 25 for 25% or 500000 for 500,000 Tomans
  maxUses   Int       @default(100)
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

