export async function searchCoursesLive(query: string) {
  if (!query || query.trim().length < 2) return [];
  return prisma.course.findMany({
    where: {
      isPublished: true,
      OR: [
        { title: { contains: query.trim() } },
        { shortDesc: { contains: query.trim() } },
        { instructorName: { contains: query.trim() } },
      ],
    },
    select: {
      id: true,
      title: true,
      slug: true,
      thumbnail: true,
      price: true,
      discountPrice: true,
      instructorName: true,
      category: { select: { name: true } },
