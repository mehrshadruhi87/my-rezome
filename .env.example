# Runtime & URLs
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=https://codeacademy-ir.netlify.app
CORS_ALLOWED_ORIGINS=https://codeacademy-ir.netlify.app,http://localhost:3000,http://localhost:8888
VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloud PostgreSQL (Neon / Supabase - include ?pgbouncer=true&connection_limit=1 for serverless pooling)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/codeacademy?sslmode=require&pgbouncer=true&connection_limit=1

# JWT Authentication (Generate strong random 64-byte secrets in production)
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Admin Seed Credentials
ADMIN_EMAIL=mehrshadruhi87@gmail.com
ADMIN_PASSWORD=change-me-in-production

# Cloud File Storage (Cloudinary or S3)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional S3 / S3-Compatible (ArvanCloud / AWS S3 / R2)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://codeacademy-ir.netlify.app/api/payments/zarinpal/callback

# Email Service (SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CodeAcademy <no-reply@codeacademy.ir>"
